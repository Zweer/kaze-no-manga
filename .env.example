# Database (Neon)
DATABASE_URL=postgres://...          # Pooled connection (runtime)
DATABASE_URL_UNPOOLED=postgres://...  # Direct connection (drizzle-kit migrations)

# Better Auth
BETTER_AUTH_SECRET=                   # Random secret (openssl rand -base64 32)
BETTER_AUTH_URL=http://localhost:3000 # App URL

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
